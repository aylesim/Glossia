# Server-side defaults. The studio can also receive a provider/model/key per
# request in live mode; keys typed into the UI stay in the tab's sessionStorage.

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, a local mock.
# OPENAI_BASE_URL=http://127.0.0.1:4010/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=Glossia

# Optional
# PORT=3000
